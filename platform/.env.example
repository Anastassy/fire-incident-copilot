# Copy this file to `.env` and fill in real values. `.env` itself is gitignored --
# never commit real secrets. See app/core/config.py for the authoritative field list
# and Python-level fallback defaults (those fallbacks are for pure local/no-.env runs
# only; a real deploy should always set these explicitly).

# --- Database / cache -------------------------------------------------------
# Local `docker compose` default: host port 5433 maps to the `db` container's 5432
# (5432 is often already taken by another local project). Inside the docker network the
# app/bridge containers reach it as db:5432 -- docker-compose.yml sets that for you
# automatically, this line is only what your HOST-side tools/tests connect to.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/platform
REDIS_URL=redis://localhost:6379/0
# `pytest` never touches the database above -- tests/conftest.py isolates the whole
# suite onto its own database (same Postgres server, different name), creating it and
# running migrations automatically if needed. Optional: only set this if you want the
# test database to live somewhere other than the default `<DATABASE_URL's db>_test`
# (e.g. `platform_test` for the line above). Uncomment to override:
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/platform_test

# --- Shared-secret auth (app.core.security.ApiKeyMiddleware) ----------------
# Required X-API-Key header value for every non-exempt HTTP request (REST, SSE, the
# mounted MCP server) and for WS /ingest/stream. Generate a real random value for any
# real deploy -- do NOT ship with the placeholder below.
API_KEY=change-me-to-a-real-shared-secret

# --- State Machine bridge (app/adapter/bridge.py, `bridge` compose service) -
# Base URL of the simulator team's State Machine API.
STATE_MACHINE_BASE_URL=https://api.aitinkerers.space/api/v1
# Real bearer token -- 1Password vault "aitinkerers-hack", item "State Machine API".
# Never hardcode it here or anywhere else; leave blank to run without the bridge (it
# logs a message and exits cleanly instead of crash-looping, see bridge.py's guard).
STATE_MACHINE_BEARER_TOKEN=
# Which simulator scenario to run, e.g. degraded / palisades-focus / palisades-full.
STATE_MACHINE_SCENARIO_ID=degraded
# Where the bridge posts mapped telemetry. Only relevant for a non-containerized/manual
# bridge run against localhost -- docker-compose.yml overrides this to http://app:8000
# for the containerized `bridge` service, since `localhost` inside that container would
# not reach the `app` container.
OUR_API_BASE_URL=http://localhost:8000
