# Copy to .env (gitignored), set your vault name, then load with op run.
# This file contains a secret reference, never an actual API key.
FIRE_ENGINE=sdk
FIRE_PROVIDER=openrouter
FIRE_MODEL=openai/gpt-6-astra
FIRE_FALLBACK_MODEL=anthropic/claude-fable-5.1
FIRE_OUTPUT_LANGUAGE=en
FIRE_DB_PATH=work/openrouter-ui.sqlite3
OPENROUTER_API_KEY=op://YOUR_VAULT/OpenRouter API Key - demo/credential
