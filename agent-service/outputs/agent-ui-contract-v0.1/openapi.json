  "security": [
    {
      "UiSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "UiSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fire_ui_session",
        "description": "Proposed same-origin backend session; deployment auth not yet implemented. Platform API key never reaches browser."
      }
    },
    "schemas": {
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "demo_context_id": {
            "type": "string"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "subject_id": {
            "type": "string"
          }
        },
        "required": [
          "demo_context_id",
          "generation",
          "subject_id"
        ]
      },
      "Coverage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "as_of_ms": {
            "type": "integer",
            "minimum": 0
          },
          "checked_from_ms": {
            "type": "integer",
            "minimum": 0
          },
          "checked_until_ms": {
            "type": "integer",
            "minimum": 0
          },
          "completeness": {
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "as_of_ms",
          "checked_from_ms",
          "checked_until_ms",
          "completeness",
          "limitations"
        ]
      },
      "Query": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query_id": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "filters": {
            "type": "object",
            "additionalProperties": true
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "enum": [
              "running",
              "succeeded",
              "failed"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "partial",
              "unknown"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "query_id",
          "tool",
          "filters",
          "started_at",
          "completed_at",
          "status",
          "completeness",
          "error_code"
        ]
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source_report",
              "measurement",
              "inference",
              "absence_in_checked_data"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "claim_id",
          "text",
          "kind",
          "evidence_ids"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id"
        ]
      },
      "QuestionCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "client_request_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "language": {
            "enum": [
              "en",
              "ru"
            ]
          }
        },
        "required": [
          "context",
          "client_request_id",
          "question",
          "language"
        ]
      },
      "Answer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "ready",
              "insufficient_data",
              "error",
              "cancelled"
            ]
          },
          "question": {
            "type": "string"
          },
          "language": {
            "enum": [
              "en",
              "ru"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "queries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "request_id",
          "context",
          "revision",
          "status",
          "question",
          "language",
          "claims",
          "unknowns",
          "coverage",
          "queries",
          "evidence_ids",
          "created_at",
          "completed_at",
          "error"
        ]
      },
      "Card": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "platform_incident_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "statement": {
            "type": "string"
          },
          "assessment": {
            "enum": [
              "checking",
              "supported",
              "refuted",
              "insufficient_data"
            ]
          },
          "lifecycle": {
            "enum": [
              "active",
              "closed"
            ]
          },
          "platform_status": {
            "enum": [
              "open",
              "acknowledged",
              "resolved",
              "escalated",
              null
            ]
          },
          "publication_status": {
            "enum": [
              "pending",
              "synced",
              "uncertain",
              "error"
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coverage": {
            "$ref": "#/components/schemas/Coverage"
          },
          "queries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Query"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "closure_reason": {
            "type": [
